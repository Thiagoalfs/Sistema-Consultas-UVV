@model IEnumerable<SistemaConsultasUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Consulta</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Especialidade</th>
            <th>Data e Hora</th>
            <th>Descrição</th>
            <th class="text-center" style="width: 180px;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Nenhuma consulta agendada até o momento.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Especialidade</td>
                    <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Descricao</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>