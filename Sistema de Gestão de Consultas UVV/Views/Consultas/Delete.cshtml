@model SistemaConsultasUVV.Models.Consulta

@{
    ViewData["Title"] = "Excluir Consulta";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="text-danger mb-3">Confirmar Exclusão</h2>
        <h5>Tem certeza que deseja cancelar esta consulta?</h5>

        <div class="card p-3 my-3">
            <dl class="row mb-0">
                <dt class="col-sm-4">Especialidade</dt>
                <dd class="col-sm-8">@Model.Especialidade</dd>

                <dt class="col-sm-4">Data e Hora</dt>
                <dd class="col-sm-8">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Descrição</dt>
                <dd class="col-sm-8">@Model.Descricao</dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Excluir Registro</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>